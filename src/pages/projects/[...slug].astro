---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import SectionNav from "../../components/SectionNav.astro";
import ProjectGlyph from "../../components/ProjectGlyph.astro";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((project) => ({
        params: { slug: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, date, tags, role, techStack, image, github, demo } =
    project.data;

const meta = ["Projet", date.getFullYear(), ...tags].join(" · ");
---

<Layout title={`${title} — Théo Bourdel`} description={description}>
    <div class="h-screen flex flex-col">
        <Header />

        <main class="flex-1 min-h-0 grid lg:grid-cols-2">
            <div
                class="hidden lg:grid place-items-center border-r border-border p-10"
            >
                {
                    image ? (
                        <Image
                            src={image}
                            alt={title}
                            width={1200}
                            height={800}
                            class="max-w-full max-h-full object-contain"
                        />
                    ) : (
                        <ProjectGlyph seed={project.id} />
                    )
                }
            </div>

            <div class="overflow-y-auto px-[18px] md:px-12 py-8 md:py-12">
                <a
                    href="/#projects"
                    class="group label-accent inline-flex items-center gap-2"
                >
                    <span
                        class="transition-transform duration-300 group-hover:-translate-x-1"
                        >←</span
                    >
                    Retour aux projets
                </a>

                <p class="label mt-7">{meta}</p>

                <h1
                    class="mt-3 font-bold tracking-tightest text-4xl md:text-6xl leading-[1.02]"
                >
                    {title}
                </h1>

                <p
                    class="mt-5 text-lg md:text-xl leading-[1.65] text-text-secondary"
                >
                    {description}
                </p>

                <div class="mt-8 grid sm:grid-cols-2 border border-border">
                    <div
                        class="p-5 border-b sm:border-b-0 sm:border-r border-border"
                    >
                        <p class="label">Rôle</p>
                        <p class="mt-1.5 font-semibold">{role}</p>
                    </div>
                    <div class="p-5">
                        <p class="label">Stack</p>
                        <p class="mt-1.5 font-semibold">
                            {techStack.join(" · ") || "—"}
                        </p>
                    </div>
                </div>

                {
                    (demo || github) && (
                        <div class="mt-7 flex flex-wrap gap-3">
                            {demo && (
                                <a
                                    href={demo}
                                    target="_blank"
                                    rel="noopener"
                                    class="btn-primary"
                                >
                                    Voir la démo ↗
                                </a>
                            )}
                            {github && (
                                <a
                                    href={github}
                                    target="_blank"
                                    rel="noopener"
                                    class="btn-ghost"
                                >
                                    GitHub ↗
                                </a>
                            )}
                        </div>
                    )
                }

                <div
                    class="mt-12 pt-10 border-t border-border prose prose-invert max-w-none
                    prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-text-primary
                    prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4
                    prose-h3:text-lg prose-h3:mt-8 prose-h3:mb-3
                    prose-p:text-text-secondary prose-p:leading-[1.75]
                    prose-a:text-accent prose-a:no-underline hover:prose-a:underline prose-a:underline-offset-4
                    prose-strong:text-text-primary
                    prose-code:text-accent prose-code:bg-bg-card prose-code:px-1.5 prose-code:py-0.5 prose-code:before:content-[''] prose-code:after:content-['']
                    prose-pre:bg-bg-soft prose-pre:border prose-pre:border-border
                    prose-li:text-text-secondary prose-li:marker:text-accent
                    prose-img:border prose-img:border-border
                    prose-blockquote:border-l-2 prose-blockquote:border-accent prose-blockquote:not-italic prose-blockquote:text-text-secondary
                    prose-hr:border-border"
                >
                    <Content />
                </div>
            </div>
        </main>

        <SectionNav />
    </div>
</Layout>
