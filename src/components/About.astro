---
import { getCollection } from "astro:content";

const entries = await getCollection("about");
const { headline, bio, hobbies, experiences, studies } = entries[0].data;
---

<section
    id="about"
    class="screen px-[18px] md:px-7 xl:px-11 py-6 md:py-8 xl:py-11"
>
    <div
        class="h-full grid xl:grid-cols-[1.05fr_.95fr] gap-7 xl:gap-11 items-center"
    >
        <div class="reveal min-w-0">
            <h2 class="section-title">À propos</h2>

            <h3
                class="mt-6 text-xl md:text-[28px] font-bold tracking-[-0.02em] leading-snug"
            >
                {headline}
            </h3>

            <div
                class="mt-5 space-y-3.5 text-[15px] leading-[1.7] text-text-secondary max-w-xl"
            >
                {bio.map((p) => <p>{p}</p>)}
            </div>

            <p class="label-accent mt-9 mb-4">Hors du code</p>
            <div class="grid sm:grid-cols-2 gap-x-8 gap-y-5">
                {
                    hobbies.map((h, i) => (
                        <div
                            class="reveal border-l border-border pl-4 hover:border-accent transition-colors duration-300"
                            style={`--delay: ${300 + i * 80}ms`}
                        >
                            <h4 class="font-semibold">{h.label}</h4>
                            <p class="text-sm text-text-secondary mt-1 leading-relaxed">
                                {h.description}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>

        <div class="reveal panel p-6 md:p-9 min-w-0" style="--delay: 160ms">
            <p class="label-accent mb-5">Parcours pro</p>
            <ul class="divide-y divide-border">
                {
                    experiences.map((e) => (
                        <li class="py-3.5 first:pt-0 group flex items-baseline justify-between gap-6">
                            <div>
                                <h4 class="font-semibold group-hover:text-accent transition-colors duration-300">
                                    {e.role}
                                </h4>
                                <p class="text-sm text-text-secondary mt-0.5">
                                    {e.company}
                                </p>
                            </div>
                            <span class="font-mono text-xs text-text-muted shrink-0">
                                {e.period}
                            </span>
                        </li>
                    ))
                }
            </ul>

            <p class="label-accent mt-9 mb-5">Études</p>
            <ul class="divide-y divide-border">
                {
                    studies.map((s) => (
                        <li class="py-3.5 first:pt-0 flex items-baseline justify-between gap-6">
                            <h4 class="text-[17px] hover:text-accent transition-colors duration-300">
                                {s.degree}
                            </h4>
                            <span class="font-mono text-xs text-text-muted shrink-0">
                                {s.period}
                            </span>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</section>
