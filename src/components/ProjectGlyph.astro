---
interface Props {
    seed: string;
    size?: "sm" | "lg";
}

const { seed, size = "lg" } = Astro.props;

let h = 0;
for (let i = 0; i < seed.length; i++) h = (h * 31 + seed.charCodeAt(i)) >>> 0;
const cells = Array.from(
    { length: 9 },
    (_, i) => ((h >> i) & 1) === 1 || i === 4
);

const cell = size === "lg" ? "w-[72px] h-[64px]" : "w-2.5 h-2.5";
const gap = size === "lg" ? "gap-1.5" : "gap-[3px]";
---

<div class={`grid grid-cols-3 ${gap} shrink-0`}>
    {
        cells.map((on, i) => (
            <span
                class={`${cell} transition-colors duration-500 ${on ? "bg-accent" : "bg-track"}`}
                style={`transition-delay: ${i * 30}ms`}
            />
        ))
    }
</div>
