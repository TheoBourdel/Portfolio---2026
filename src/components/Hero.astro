---
const facts = [
    { value: "3 ans", label: "Expérience" },
    { value: "16", label: "Technologies" },
    { value: "React · TS", label: "Focus actuel" },
];
---

<section
    id="hero"
    class="screen flex items-start md:items-center justify-center text-center
                          px-[18px] md:px-11 pt-8 pb-12 md:py-16"
>
    <div class="w-full max-w-[860px] mx-auto flex flex-col items-center">
        <div class="reveal" style="--delay: 60ms">
            <span class="eyebrow"
                ><span class="dot"></span>Disponible pour de nouveaux projets</span
            >
        </div>

        <h1
            class="reveal mt-[30px] font-bold tracking-tightest leading-[1.02] text-[40px] md:text-[58px] xl:text-[76px] text-balance"
            style="--delay: 160ms"
        >
            Je conçois des produits web <span class="text-accent">soignés.</span
            >
        </h1>

        <p
            class="reveal mt-6 max-w-[620px] text-base md:text-[19px] leading-[1.65] text-text-secondary text-pretty"
            style="--delay: 260ms"
        >
            Développeur full-stack près de Paris. Élégants, rapides et
            accessibles — du pixel au déploiement, de la conception d'interface
            à la mise en production.
        </p>

        <div
            class="reveal mt-8 flex flex-col sm:flex-row gap-3"
            style="--delay: 360ms"
        >
            <a href="/BOURDEL_Théo_CV.pdf" download class="btn-primary"
                >Télécharger mon CV</a
            >
            <a href="/#contact" class="btn-ghost">Me contacter</a>
        </div>

        <div
            class="reveal w-full mt-9 md:mt-[52px] md:pt-6 md:border-t border-border
                flex flex-wrap justify-center gap-3 md:gap-0"
            style="--delay: 460ms"
        >
            {
                facts.map((f) => (
                    <div class="flex-1 basis-[140px] flex flex-col items-center gap-1.5">
                        <p class="text-lg md:text-2xl font-bold">{f.value}</p>
                        <p class="label">{f.label}</p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
