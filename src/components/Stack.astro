---
import { getCollection } from "astro:content";
import * as simpleIcons from "simple-icons";

const entries = await getCollection("stack");
const categories = entries[0]?.data.categories ?? [];
const total = categories.reduce((n, c) => n + c.techs.length, 0);

const getIcon = (name?: string) =>
    name
        ? (simpleIcons as Record<string, { path: string; hex: string }>)[name]
        : undefined;

const mark = (name: string) => name.slice(0, 2).toUpperCase();
---

<section
    id="stack"
    class="screen flex flex-col px-[18px] md:px-7 xl:px-11 py-6 md:py-8 xl:py-11"
>
    <div
        class="reveal flex flex-wrap items-baseline justify-between gap-4 mb-[22px] shrink-0"
    >
        <h2 class="section-title">Stack technique</h2>
        <span class="label">{total} technologies · Niveau / Ancienneté</span>
    </div>

    <div class="flex-1 min-h-0 overflow-y-auto overflow-x-hidden space-y-6">
        {
            categories.map((cat, ci) => (
                <div class="reveal" style={`--delay: ${120 + ci * 90}ms`}>
                    <div class="flex items-center gap-5 mb-3">
                        <span class="label-accent">{cat.name}</span>
                        <span class="flex-1 h-px bg-border" />
                        <span class="label">
                            {String(cat.techs.length).padStart(2, "0")}
                        </span>
                    </div>

                    <div class="grid gap-2.5 sm:grid-cols-2 xl:grid-cols-4">
                        {cat.techs.map((tech, ti) => {
                            const icon = getIcon(tech.icon);

                            return (
                                <article
                                    class="panel panel-hover group p-3.5 flex items-center gap-3.5"
                                    style={
                                        icon ? `--tech-color: #${icon.hex}` : ""
                                    }
                                >
                                    <span
                                        class="shrink-0 w-[38px] h-[38px] grid place-items-center
                             bg-accent-tint border border-accent-edge
                             group-hover:border-[var(--tech-color,#ff7a2f)] transition-colors duration-300"
                                    >
                                        {icon ? (
                                            <svg
                                                role="img"
                                                viewBox="0 0 24 24"
                                                aria-label={tech.name}
                                                class="w-[17px] h-[17px] fill-accent group-hover:fill-[var(--tech-color)] transition-colors duration-300"
                                            >
                                                <path d={icon.path} />
                                            </svg>
                                        ) : (
                                            <span class="font-mono text-xs font-semibold text-accent">
                                                {mark(tech.name)}
                                            </span>
                                        )}
                                    </span>

                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-baseline justify-between gap-3">
                                            <h3 class="font-semibold truncate">
                                                {tech.name}
                                            </h3>
                                            <span class="font-mono text-xs text-text-muted shrink-0">
                                                {tech.years
                                                    ? `${tech.years} an${tech.years > 1 ? "s" : ""}`
                                                    : "—"}
                                            </span>
                                        </div>

                                        <div class="mt-2 flex gap-1.5">
                                            {Array.from({ length: 5 }).map(
                                                (_, i) => (
                                                    <span class="h-1 flex-1 bg-track overflow-hidden">
                                                        {i < tech.level && (
                                                            <span
                                                                class="bar-fill block h-full w-full bg-accent"
                                                                style={`--delay: ${300 + ti * 45 + i * 55}ms`}
                                                            />
                                                        )}
                                                    </span>
                                                )
                                            )}
                                        </div>
                                    </div>
                                </article>
                            );
                        })}
                    </div>
                </div>
            ))
        }
    </div>
</section>
