---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import ProjectGlyph from "./ProjectGlyph.astro";

const all = await getCollection("projects");
const projects = all.sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return b.data.date.valueOf() - a.data.date.valueOf();
});

const metaLine = (p: (typeof projects)[number]) =>
    [p.data.date.getFullYear(), ...p.data.tags].join(" · ");
---

<section
    id="projects"
    class="screen flex flex-col px-[18px] md:px-7 xl:px-11 py-6 md:py-8 xl:py-11"
>
    <div
        class="reveal flex items-baseline justify-between gap-4 mb-[22px] shrink-0"
    >
        <h2 class="section-title">Projets</h2>
        <span class="label">
            <span id="proj-current">01</span> / {
                String(projects.length).padStart(2, "0")
            }
        </span>
    </div>

    <div
        class="reveal panel flex-1 min-h-0 overflow-hidden"
        style="--delay: 140ms"
    >
        {
            projects.map((p, i) => (
                <article
                    data-slide={i}
                    class={`grid lg:grid-cols-2 h-full ${i === 0 ? "" : "hidden"}`}
                >
                    <div class="grid place-items-center border-b lg:border-b-0 lg:border-r border-border p-8 bg-bg">
                        {p.data.image ? (
                            <Image
                                src={p.data.image}
                                alt={p.data.title}
                                width={900}
                                height={600}
                                class="max-w-full max-h-full object-contain"
                            />
                        ) : (
                            <ProjectGlyph seed={p.id} />
                        )}
                    </div>

                    <div class="p-8 md:p-12 flex flex-col justify-center overflow-y-auto">
                        <p class="label">{metaLine(p)}</p>
                        <h3 class="mt-3 text-3xl md:text-5xl font-bold tracking-tightest">
                            {p.data.title}
                        </h3>
                        <p class="mt-4 text-base md:text-lg leading-[1.65] text-text-secondary max-w-lg">
                            {p.data.description}
                        </p>
                        <a
                            href={`/projects/${p.id}`}
                            class="group mt-7 inline-flex items-center gap-2 font-bold text-accent w-fit"
                        >
                            Voir le projet
                            <span class="transition-transform duration-300 group-hover:translate-x-1.5">
                                →
                            </span>
                        </a>
                    </div>
                </article>
            ))
        }
    </div>

    <div
        class="reveal mt-4 flex items-stretch gap-2 sm:gap-2.5 shrink-0"
        style="--delay: 240ms"
    >
        <button
            data-prev
            aria-label="Projet précédent"
            class="panel panel-hover px-3.5 sm:px-5 shrink-0 text-text-muted hover:text-text-primary"
            >←</button
        >

        <div
            id="thumb-track"
            class="flex-1 min-w-0 flex gap-2 sm:gap-2.5 overflow-x-auto snap-x snap-mandatory scroll-smooth
                [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        >
            {
                projects.map((p, i) => (
                    <button
                        data-thumb={i}
                        class="thumb panel panel-hover shrink-0 snap-center
                 w-[168px] sm:w-[212px] lg:w-[240px]
                 flex items-center gap-2.5 sm:gap-3.5 px-3 sm:px-4 py-2.5 sm:py-3 text-left"
                    >
                        <span class="shrink-0 w-8 h-8 sm:w-10 sm:h-10 grid place-items-center overflow-hidden bg-bg">
                            {p.data.image ? (
                                <Image
                                    src={p.data.image}
                                    alt=""
                                    width={80}
                                    height={80}
                                    class="w-full h-full object-cover"
                                    loading="lazy"
                                />
                            ) : (
                                <ProjectGlyph seed={p.id} size="sm" />
                            )}
                        </span>
                        <span class="min-w-0">
                            <span class="block text-[13px] sm:text-sm font-semibold truncate">
                                {p.data.title}
                            </span>
                            <span class="block font-mono text-[9px] sm:text-[10px] tracking-[0.12em] text-text-muted mt-0.5 truncate">
                                {metaLine(p)}
                            </span>
                        </span>
                    </button>
                ))
            }
        </div>

        <button
            data-next
            aria-label="Projet suivant"
            class="panel panel-hover px-3.5 sm:px-5 shrink-0 text-text-muted hover:text-text-primary"
            >→</button
        >
    </div>
</section>

<style>
    .thumb.active {
        border-color: #ff7a2f;
        background: #1c1008;
    }
</style>

<script>
    const slides = document.querySelectorAll<HTMLElement>("[data-slide]");
    const thumbs = document.querySelectorAll<HTMLElement>("[data-thumb]");
    const track = document.getElementById("thumb-track");
    const counter = document.getElementById("proj-current");
    let index = 0;

    // Recentre la vignette active dans le carrousel, sans faire bouger la page
    const scrollThumbIntoView = (el: HTMLElement) => {
        if (!track) return;
        const left = el.offsetLeft - (track.clientWidth - el.clientWidth) / 2;
        track.scrollTo({ left: Math.max(0, left), behavior: "smooth" });
    };

    const show = (n: number) => {
        index = (n + slides.length) % slides.length;

        slides.forEach((s, i) => {
            s.classList.toggle("hidden", i !== index);
            s.classList.remove("slide-enter");
            if (i === index)
                requestAnimationFrame(() => s.classList.add("slide-enter"));
        });

        thumbs.forEach((t, i) => t.classList.toggle("active", i === index));
        if (counter) counter.textContent = String(index + 1).padStart(2, "0");

        const active = thumbs[index] as HTMLElement | undefined;
        if (active) scrollThumbIntoView(active);
    };

    thumbs.forEach((t, i) => t.addEventListener("click", () => show(i)));
    document
        .querySelector("[data-prev]")
        ?.addEventListener("click", () => show(index - 1));
    document
        .querySelector("[data-next]")
        ?.addEventListener("click", () => show(index + 1));

    if (slides.length) show(0);
</script>
